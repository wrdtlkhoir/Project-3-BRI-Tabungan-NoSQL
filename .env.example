# ===== LOCAL (Docker Desktop) =====
COUCHBASE_CONN_STR=couchbase://127.0.0.1
COUCHBASE_USERNAME=Administrator
COUCHBASE_PASSWORD=password
COUCHBASE_BUCKET=bri_tabungan
COUCHBASE_SCOPE=operasional

CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=bri_tabungan

PG_DSN=host=localhost port=5434 dbname=tabungan_bri user=postgres password=password

# ===== CLOUD (contoh, tinggal ganti nilainya) =====
# COUCHBASE_CONN_STR=couchbases://cb.xxxx.cloud.couchbase.com
# COUCHBASE_USERNAME=<db-user>
# COUCHBASE_PASSWORD=<db-password>
# CASSANDRA_HOSTS=<astra-host>   # atau gunakan secure connect bundle
